{
  "name": "model-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev -w @gateway/web",
    "dev:admin": "npm run dev -w @gateway/admin",
    "dev:api": "npm run start:dev -w @gateway/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:migrate": "npm run migration:run -w @gateway/api",
    "docker:up": "docker compose up -d postgres redis minio",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "concurrently": "^9.2.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=22"
  }
}
