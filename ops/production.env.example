# Copy to ops/production.env on the deployment host and chmod 600.
IMAGE_TAG=sha-replace-with-tested-commit
POSTGRES_USER=gateway
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=gateway
# URL-encode special characters from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://gateway:replace-with-url-encoded-password@postgres:5432/gateway
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
ENCRYPTION_KEY_VERSION=production-v1
WEB_ORIGIN=https://nexus.example.com
ADMIN_ORIGIN=https://admin.nexus.example.com
OAUTH_CALLBACK_ORIGIN=https://nexus.example.com
PROVIDER_OUTBOUND_HOSTS=api.deepseek.com
# PROVIDER_GATEWAY_URL=https://internal-gateway.example.com/v1
# PROVIDER_GATEWAY_API_KEY=
BILLING_PREPAID_WORKSPACE_IDS=
# Set to the actual reverse proxy network when it differs from the Compose default.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8081
