NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
OAUTH_CALLBACK_ORIGIN=http://localhost:3000
# GITHUB_CLIENT_ID=your-github-oauth-app-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
ENCRYPTION_KEY_VERSION=local-v1
PROVIDER_CREDENTIAL_ENV=development
# Portkey or another OpenAI-compatible internal data plane. Keep unset until configured.
# PROVIDER_GATEWAY_URL=http://localhost:8787/v1
# PROVIDER_GATEWAY_API_KEY=replace-with-internal-gateway-key
PROVIDER_GATEWAY_TIMEOUT_MS=60000
# Optional dedicated TTS data plane. Falls back to PROVIDER_GATEWAY_URL.
# AUDIO_GENERATION_GATEWAY_URL=http://localhost:8787/v1
AUDIO_GENERATION_TIMEOUT_MS=300000
# Keep empty when the API is reached directly. Add only load balancer/reverse proxy CIDRs you operate.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
REQUEST_BODY_LIMIT_BYTES=1048576
GLOBAL_RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_15_MINUTES=20
INFERENCE_MAX_CONCURRENCY_PER_WORKSPACE=20
INFERENCE_CONCURRENCY_LEASE_MS=600000
TRAFFIC_CONTROL_KEY_PREFIX=nexus
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gateway
S3_SECRET_KEY=change-me
S3_BUCKET=gateway-assets
# Explicit opt-in only; existing workspaces remain unbilled by default.
BILLING_PREPAID_WORKSPACE_IDS=
