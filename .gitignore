# Dependencies for the root workspace and every nested package.
**/node_modules/
**/.pnpm-store/

# Build output and tool caches.
**/dist/
**/.vite/
**/.turbo/
**/coverage/
**/*.tsbuildinfo

# Local environment files. Keep the documented template tracked.
.env
.env.*
!.env.example

# Logs and OS files.
*.log
.DS_Store

# Local runtime data.
/data/
